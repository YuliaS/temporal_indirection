# Competency Questions for Temporal Indirection Pattern

PREFIX fd: <http://example.org/financial-derivatives#>
PREFIX ti: <http://ontologydesignpatterns.org/cp/owl/temporalindirection.owl#>
PREFIX ex: <http://example.org/financial-derivatives/instances#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# CQ1: What is the current referent for a given persistent reference?
# Expected: CLU25 for CL1 on 2025-08-14
SELECT ?referent WHERE {
    ex:CL1 ti:hasTemporalBinding ?binding .
    ?binding ti:bindsTo ?referent ;
             ti:hasValidTime ?period .
    ?period ti:hasStartTime ?start ;
            ti:hasEndTime ?end .
    FILTER("2025-08-14T12:00:00Z"^^xsd:dateTime >= ?start && 
           "2025-08-14T12:00:00Z"^^xsd:dateTime < ?end)
}

# CQ2: What was the referent at a specific historical timestamp?
# Expected: CLN25 for CL1 on 2025-07-14
SELECT ?referent WHERE {
    ex:CL1 ti:hasTemporalBinding ?binding .
    ?binding ti:bindsTo ?referent ;
             ti:hasValidTime ?period .
    ?period ti:hasStartTime ?start ;
            ti:hasEndTime ?end .
    FILTER("2025-07-14T12:00:00Z"^^xsd:dateTime >= ?start && 
           "2025-07-14T12:00:00Z"^^xsd:dateTime < ?end)
}

# CQ3: When did the referent transition occur?
# Expected: 2025-07-15T15:00:00Z and 2025-08-15T15:00:00Z
SELECT ?timestamp ?from ?to WHERE {
    ?roll a fd:ContractRoll ;
          ti:hasTimestamp ?timestamp ;
          fd:rollsFrom ?from ;
          fd:rollsTo ?to .
}
ORDER BY ?timestamp

# CQ4: What observations are associated with a specific referent?
# Expected: Observations for CLU25
SELECT ?obs ?price ?time WHERE {
    ?obs ti:observedReferent ex:CLU25 ;
         fd:hasPrice ?price ;
         ti:hasObservationTime ?time .
}

# CQ5: What is the complete history of referents for a persistent reference?
# Expected: CLN25, CLQ25, CLU25 for CL1
SELECT ?referent ?start ?end WHERE {
    ex:CL1 ti:hasTemporalBinding ?binding .
    ?binding ti:bindsTo ?referent ;
             ti:hasValidTime ?period .
    ?period ti:hasStartTime ?start ;
            ti:hasEndTime ?end .
}
ORDER BY ?start

# CQ6: What transition rule triggered a specific referent change?
# Expected: CL_RollRule for all transitions
SELECT ?roll ?rule WHERE {
    ?roll a fd:ContractRoll ;
          ti:triggeredBy ?rule .
}

# CQ7: Are there any gaps or overlaps in the temporal bindings?
# Check for overlapping periods (should return empty if no overlaps)
SELECT ?ref ?binding1 ?binding2 ?start1 ?end1 ?start2 ?end2 WHERE {
    ?ref ti:hasTemporalBinding ?binding1 ;
         ti:hasTemporalBinding ?binding2 .
    FILTER(?binding1 != ?binding2)
    ?binding1 ti:hasValidTime ?period1 .
    ?binding2 ti:hasValidTime ?period2 .
    ?period1 ti:hasStartTime ?start1 ; ti:hasEndTime ?end1 .
    ?period2 ti:hasStartTime ?start2 ; ti:hasEndTime ?end2 .
    FILTER(?start2 < ?end1 && ?start1 < ?end2)
}

# CQ8: What are the spread relationships between related references?
# Expected: CL1-CL2 spread with value -0.50
SELECT ?spread ?nearLeg ?farLeg ?value WHERE {
    ?spread a fd:CalendarSpread ;
            fd:hasNearLeg ?nearLeg ;
            fd:hasFarLeg ?farLeg .
    OPTIONAL {
        ?obs fd:observedSpread ?spread ;
             fd:hasSpreadValue ?value .
    }
}